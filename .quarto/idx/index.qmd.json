p>Collect and organize insights from your research</p>\n      <a href=\"public/takeaways.html\" class=\"feature-link\">\n        See Takeaways →\n      </a>\n    </div>\n\n    <div class=\"feature-card\">\n      <div class=\"feature-icon\">📊</div>\n      <h3>Feedback Dashboard</h3>\n      <p>View and manage all your contributions and ratings</p>\n      <a href=\"public/feedback-dashboard.html\" class=\"feature-link\">\n        Open Dashboard →\n      </a>\n    </div>\n  </div>\n</div>\n\n<!-- Topics Section -->\n<div class=\"topics-section\">\n  <h2>Research Topics</h2>\n  <p class=\"section-subtitle\">Explore cutting-edge research areas</p>\n\n  <div class=\"topics-grid\">\n    <a href=\"public/topics/ai-agents.html\" class=\"topic-card\">\n      <div class=\"topic-icon\">🤖</div>\n      <h3>AI Agents</h3>\n      <p>Autonomous systems, tool use, planning, and multi-agent coordination</p>\n      <span class=\"topic-count\">67 papers</span>\n    </a>\n\n    <a href=\"public/topics/llm-reasoning.html\" class=\"topic-card\">\n      <div class=\"topic-icon\">🧠</div>\n      <h3>LLM Reasoning</h3>\n      <p>Chain-of-thought, self-consistency, tree-of-thought, verification</p>\n      <span class=\"topic-count\">28 papers</span>\n    </a>\n\n    <a href=\"public/topics/rag-retrieval.html\" class=\"topic-card\">\n      <div class=\"topic-icon\">🔍</div>\n      <h3>RAG & Retrieval</h3>\n      <p>Dense retrieval, hybrid search, knowledge grounding, citation</p>\n      <span class=\"topic-count\">5 papers</span>\n    </a>\n\n    <a href=\"public/topics/multi-modal.html\" class=\"topic-card\">\n      <div class=\"topic-icon\">🎨</div>\n      <h3>Multi-modal</h3>\n      <p>Vision-language models, audio processing, cross-modal reasoning</p>\n      <span class=\"topic-count\">2 papers</span>\n    </a>\n  </div>\n</div>\n\n<!-- CTA Section -->\n<div class=\"cta-section\">\n  <div class=\"cta-content\">\n    <h2>Ready to Start Your Research Journey?</h2>\n    <p>Join the collaborative r